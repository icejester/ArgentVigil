# ArgentVigil backend (api-split-implementation-plan.md Story 1.3).
# Serves the FastAPI app via uvicorn. `backend/`, `pipeline/`, and `seed_data/`
# are the only source trees this image needs — pipeline/ stays stdlib-only by
# its own convention, but it's still copied in since backend/main.py's CoT
# route space imports from it.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ backend/
COPY pipeline/ pipeline/
COPY seed_data/ seed_data/

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
