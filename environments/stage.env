# A protected, currently-frozen environment.
# REFRESH_POLICY=protected means utils/refresh-test-db.sh refuses to
# target this environment's HOST_RUNTIME_DIR at all — its data is never
# overwritten from prod.
# UPDATE_MODE=frozen means the collector service does NOT run — this
# environment only ever serves whatever's already in its DB; no upstream
# fetches happen until this is flipped to "live" and the environment is
# brought up again.
AV_ENV_NAME=stage
API_PORT=7770
WEB_PORT=7769
HOST_RUNTIME_DIR=./runtime/data/stage
REFRESH_POLICY=protected
UPDATE_MODE=frozen
AI_BACKEND=forge
