# ArgentVigil frontend (api-split-implementation-plan.md Story 1.3).
# Multi-stage: build the Vite bundle, then serve it (plus the /stack_images
# reverse proxy — Story 1.4, same nginx config) via nginx. No frontend code
# runs at request time; VITE_API_BASE_URL is baked in at build time per
# Story 1.2's convention (empty string = same-origin, which is wrong for
# this deploy shape unless the compose build arg sets it).
FROM node:20-slim AS build

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

COPY frontend/ ./

ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Visual "am I in test" indicator (App.jsx's HeaderHealthDot) — must be
# declared as an ARG here or docker-compose.yml's build.args value for it
# is silently dropped and never reaches Vite at all (confirmed live
# 2026-09-16: this was exactly missing, so VITE_AV_ENV was undefined at
# build time and the dot fell back to its "prod" green, despite compose
# passing "test" — Vite's import.meta.env replacement only sees what's an
# actual process env var during `npm run build`, which only happens if
# the Dockerfile ARG exists to receive the build arg into one).
ARG VITE_AV_ENV=""
ENV VITE_AV_ENV=${VITE_AV_ENV}

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
