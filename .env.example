FRED_API_KEY=
ANTHROPIC_API_KEY=
# GoldAPI.io — LBMA gold AM fix + silver daily fix (free tier, 500 req/month).
# Optional: app boots fine without it, lbma_fix table just stays empty.
GAPI_API_KEY=
# U.S. Census Bureau International Trade API — free, self-service signup at
# https://api.census.gov/data/key_signup.html. Optional: app boots fine
# without it, census_trade table just stays empty.
CENSUS_API_KEY=
# AI_BACKEND: leave unset to default to "forge" (local amp-forge/Ollama test
# box, cheap iteration). Set to "anthropic" to point at real Claude compute.
AI_BACKEND=
FORGE_URL=
# CORS: comma-separated list of browser origins (scheme+host+port) allowed to
# call this API from JS. Defaults to http://localhost:5173 (today's Vite dev
# server) if unset. The real LAN value is TBD until the containerized `web`
# service exists and its access pattern (local-only vs. also-from-other-
# devices) is known — see specs/api-split-spec.md §6.
CORS_ALLOWED_ORIGINS=http://localhost:5173
