# "Test AV" — the original disposable containerized environment
# (api-split-implementation-plan.md Story 1.3).
# REFRESH_POLICY=snapshot means utils/refresh-test-db.sh is allowed to
# overwrite HOST_RUNTIME_DIR from prod's real data on demand; this
# environment never holds anything you'd be sad to lose to the next
# refresh.
# UPDATE_MODE=live means the collector service runs, so this environment
# also keeps fetching from real upstreams on its own schedule while it's up.
AV_ENV_NAME=test
API_PORT=6978
WEB_PORT=6977
HOST_RUNTIME_DIR=./runtime/data/test
REFRESH_POLICY=snapshot
UPDATE_MODE=live
AI_BACKEND=forge
